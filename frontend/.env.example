# Opcional: Client ID de Google Identity Services (Google Cloud Console -> OAuth 2.0 Client IDs)
# Si se deja vacío, Ronda habilita el selector interactivo de Gmail sin contraseñas (Zero-PII).
VITE_GOOGLE_CLIENT_ID=

# Opcional: URL externa del backend si se aloja por separado (ej. Render/Railway).
# En Vercel todo-en-uno o en localhost no hace falta configurarla (se detecta automáticamente).
VITE_API_URL=
